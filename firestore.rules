rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActiveApproved() {
      return isSignedIn() && myProfile().approved == true && myProfile().active == true;
    }
    function isLeader() {
      return isActiveApproved() && myProfile().role in ['manager', 'admin'];
    }
    function isAdmin() {
      return isActiveApproved() && myProfile().role == 'admin';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isLeader());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.approved == resource.data.approved &&
        request.resource.data.active == resource.data.active
      );
    }

    match /invites/{inviteCode} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']) &&
        request.resource.data.usedCount == resource.data.usedCount + 1
      );
    }

    match /meta/bootstrap {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // 店舗・予定・訪問記録（メンバーは本人分のみ、マネージャー・管理者は全体閲覧可）
    match /stores/{storeId} {
      allow read: if isActiveApproved() && (isLeader() || resource.data.ownerUid == request.auth.uid);
      allow create: if isActiveApproved() && (isLeader() || request.resource.data.ownerUid == request.auth.uid);
      allow update: if isActiveApproved() && (isLeader() || resource.data.ownerUid == request.auth.uid);
      allow delete: if isActiveApproved() && (isLeader() || resource.data.ownerUid == request.auth.uid);
    }

    match /schedules/{scheduleId} {
      allow read: if isActiveApproved() && (isLeader() || resource.data.ownerUid == request.auth.uid);
      allow create: if isActiveApproved() && (isLeader() || request.resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isActiveApproved() && (isLeader() || resource.data.ownerUid == request.auth.uid);
    }

    match /visits/{visitId} {
      allow read: if isActiveApproved() && (isLeader() || resource.data.ownerUid == request.auth.uid);
      allow create: if isActiveApproved() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // お知らせ（全員閲覧可、作成・削除はマネージャー・管理者のみ、既読は本人のみ書込可）
    match /announcements/{annId} {
      allow read: if isActiveApproved();
      allow create, update, delete: if isLeader();

      match /reads/{uid} {
        allow read: if isActiveApproved() && request.auth.uid == uid;
        allow write: if isActiveApproved() && request.auth.uid == uid;
      }
    }
  }
}
